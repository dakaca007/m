{
    "name": "phalapi/qiniu-demo",
    "description": "Dockerized PhalApi with Qiniu",
    "type": "project",
    "require": {
        "phalapi/phalapi": "^2.23.3",
        "phalapi/cli": "^3.4",
        "qiniu/php-sdk": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "App\\\\": "app/"
        }
    },
  "minimum-stability": "dev", 
  "prefer-stable": true,      
    "scripts": {
        "post-install-cmd": [
            "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    }
}